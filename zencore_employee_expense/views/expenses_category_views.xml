<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="product_product_expense_form_inherit_account_payable"
            model="ir.ui.view">
        <field name="name">
            product.product.expense.form.inherit.account.payable
        </field>

        <field name="model">product.product</field>

        <field name="inherit_id"
               ref="hr_expense.product_product_expense_form_view"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">

                <group string="Accounting">
                    <field name="account_payable_id"/>
                </group>

            </xpath>

        </field>

    </record>

</odoo>