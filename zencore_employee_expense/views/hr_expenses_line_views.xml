<?xml version="1.0" encoding="utf-8"?>

<odoo>


    <record id="hr_expense_form_monthly_expense"
            model="ir.ui.view">


        <field name="name">
            hr.expense.form.monthly.expense
        </field>


        <field name="model">hr.expense</field>


        <field name="inherit_id"
               ref="hr_expense.hr_expense_view_form"/>



        <field name="arch" type="xml">


            <!-- Hide Default Product -->

            <xpath expr="//field[@name='product_id']"
                   position="attributes">

                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>

            </xpath>



            <!-- Hide Default Expense Date -->

            <xpath expr="//field[@name='date']"
                   position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>




            <!-- Hide Default Expense Account -->

            <xpath expr="//field[@name='account_id']"
                   position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>


            <!-- Hide Attach Receipt Button -->

       



            <!-- Hide Standard Amount -->

            <xpath expr="//field[@name='total_amount_currency']"
                   position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>



            <xpath expr="//field[@name='total_amount']"
                   position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>





            <!-- Add Monthly Expense Lines -->

            <xpath expr="//sheet"
                   position="inside">


                <separator string="Monthly Expense Lines"/>



                <field name="monthly_expense_line_ids"
                       readonly="state != 'draft'">


                    <list editable="bottom">


                        <!-- Expense Date -->

                        <field name="expense_date"/>



                        <!-- Description -->

                        <field name="description"/>



                        <!-- Category -->

                        <field name="category_id"
                               options="{
                                   'no_create': True,
                                   'no_open': True
                               }"/>



                        <!-- Auto Generated Account -->

                        <field name="account_id"
                               readonly="1"/>



                        <!-- Amount -->

                        <field name="amount"
                               sum="Total"/>



                        <!-- Document -->

                        <field name="document"
                               string="Document"
                               filename="document_filename"/>



                        <field name="document_filename"
                               column_invisible="True"/>



                        <!-- Technical Fields -->

                        <field name="currency_id"
                               column_invisible="True"/>


                        <field name="company_id"
                               column_invisible="True"/>


                    </list>


                </field>


            </xpath>


        </field>


    </record>


</odoo>