<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_expense_admin"
            model="ir.ui.view">

        <field name="name">
            res.config.settings.view.form.inherit.expense.admin
        </field>

        <field name="model">res.config.settings</field>

        <field name="inherit_id"
               ref="hr_expense.res_config_settings_view_form"/>

        <field name="arch" type="xml">

            <!-- Add Expense Admin after Employee Expense Journal -->
            <xpath expr="//setting[field[@name='expense_journal_id']]"
                   position="after">

                <setting
                    id="expense_admin_setting"
                    string="Expense Admin"
                    company_dependent="1"
                    help="Administrator responsible for employee expense management.">

                    <field name="expense_admin_id"
                           options="{'no_create': True}"/>

                </setting>

            </xpath>

        </field>

    </record>

</odoo>